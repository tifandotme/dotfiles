{
  "cli_default_open_behavior": "existing_window",
  "disable_ai": true,
  "when_closing_with_no_tabs": "keep_window_open",
  "confirm_quit": true,
  "on_last_window_closed": "quit_app",
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "base_keymap": "VSCode",
  "theme": {
    "dark": "Neo Gruber Darker",
    "light": "Gruvbox Light Hard",
    "mode": "system"
  },
  "restore_on_startup": "empty_tab",
  "format_on_save": "off",
  "file_finder": {
    "file_icons": false
  },
  "collaboration_panel": {
    "dock": "right",
    "button": true
  },
  "project_panel": {
    "default_width": 300,
    "indent_guides": {
      "show": "never"
    },
    "dock": "right",
    "entry_spacing": "standard",
    "auto_fold_dirs": false,
    "indent_size": 20,
    "folder_icons": false,
    "file_icons": false,
    "hide_root": true
  },
  "outline_panel": {
    "default_width": 300,
    "indent_guides": {
      "show": "never"
    },
    "dock": "right",
    "auto_fold_dirs": true
  },
  "git_panel": {
    "dock": "right",
    "button": false
  },
  "terminal": {
    "button": false
  },
  "buffer_font_family": "CommitMono Nerd Font",
  "buffer_font_size": 13.5,
  "buffer_line_height": "standard",
  "use_autoclose": false,
  "current_line_highlight": "all",
  "relative_line_numbers": "enabled",
  "cursor_blink": false,
  "search_wrap": false,
  "wrap_guides": [80, 100],
  "soft_wrap": "editor_width",
  "git": {
    "inline_blame": {
      "enabled": true
    }
  },
  "vim_mode": true,
  "vim": {
    "highlight_on_yank_duration": 300,
    "toggle_relative_line_numbers": true,
    "use_system_clipboard": "on_yank"
  },
  "buffer_font_features": {
    "calt": false
  },
  "languages": {
    "All": {
      "enable_language_server": false
    },
    "CSS": {
      "tab_size": 2
    },
    "Lua": {
      "tab_size": 2
    }
  },
  "file_scan_exclusions": ["**/node_modules", "**/dist", "**/docker/buildx", "**/docker/contexts"],
  "file_types": {
    "Templ": ["*.tmpl"],
    "Jinja2": ["*#template*", "*##*"],
    "Git Ignore": [".chezmoiignore"],
    "Shell Script": [".bash_profile*", ".bashrc*", "bash_aliases", "*Brewfile*", "secrets"],
    "Git Config": ["config"],
    "YAML": ["*yml*", "*yaml*"],
    "TOML": ["*toml*"]
  }
}
