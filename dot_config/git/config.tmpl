[user]
	name = Tifan Dwi Avianto
	email = 33323177+tifandotme@users.noreply.github.com
	signingkey = ~/.ssh/id_ed25519.pub
[color]
	ui = auto
[init]
	defaultbranch = master
[commit]
	gpgsign = true
[gpg]
	format = ssh
[push]
	default = current
	autoSetupRemote = true
	followTags = true
[pull]
	default = current
	rebase = true
[rebase]
	autoStash = true
	missingCommitsCheck = warn
[remote "origin"]
	prune = true
[url "git@github.com:"]
	insteadOf = https://github.com/

{{ if eq .chezmoi.os "darwin" -}}
[maintenance]
	repo = /Users/tifan/projects/work/aquasense-app
	repo = /Users/tifan/projects/work/aquasense-service
	repo = /Users/tifan/projects/work/backoffice-windmill
	repo = /Users/tifan/projects/work/gcp-terraform
	repo = /Users/tifan/projects/work/core-service
	repo = /Users/tifan/projects/personal/tifan.me
	repo = /Users/tifan/projects/personal/actual
	repo = /Users/tifan/projects/personal/box
	repo = /Users/tifan/projects/personal/hevy-cli
	repo = /Users/tifan/projects/personal/resume
	repo = {{ .chezmoi.sourceDir }}

[includeIf "gitdir:~/projects/work/"]
	path = ~/projects/work/.gitconfig

[core]
	whitespace = error
	preloadindex = true
[interactive]
	diffFilter = delta --color-only --features=interactive
[delta]
	light = false
	syntax-theme = base16
	navigate = true
	hyperlinks = true
	hyperlinks-file-link-format = "zed://file/{path}:{line}"
[merge]
	conflictstyle = zdiff3
[diff]
	colorMoved = default
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[safe]
	directory = /github/workspace
{{ end -}}
