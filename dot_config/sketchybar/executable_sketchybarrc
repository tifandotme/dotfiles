#!/bin/bash

PLUGIN_DIR="$CONFIG_DIR/plugins"

# shellcheck source=/Users/tifan/.local/share/chezmoi/dot_config/theme/palette.sh
# shellcheck disable=SC1091
source "$HOME/.config/theme/palette.sh"

bar=(
	height=22
	position=top
	padding_left=5
	padding_right=5
	y_offset=3
	color="${TRANSPARENT}"
)
sketchybar --bar "${bar[@]}"

default=(
	label.font="SF Mono:Semibold:12.5"

	icon.color="${ACCENT}"
	label.color="${FOREGROUND}"

	label.padding_right=12
	icon.padding_left=10
	icon.padding_right=6

	background.color="${BACKGROUND}"

	background.padding_left=5
	background.corner_radius=99
)
sketchybar --default "${default[@]}"

# ---------------------------------- ITEMS -------------------------------------

GHOST=(
	background.drawing=off
	label.shadow.drawing=on
	label.shadow.color="${BACKGROUND}"
	label.shadow.distance=1
	icon.shadow.drawing=on
	icon.shadow.color="${BACKGROUND}"
	icon.shadow.distance=1
)

# --------------- LEFT

sketchybar --add event aerospace_workspace_change

workspaces=$(aerospace list-workspaces --all)
first_workspace=$(echo "$workspaces" | head -n 1)
last_workspace=$(echo "$workspaces" | tail -n 1)

# without setting icon.width, focused and unfocused icon will cause layout shift
for sid in $workspaces; do
	sketchybar --add item space."$sid" left \
		--set space."$sid" \
		icon.width=20 \
		icon.padding_left=10 \
		icon.padding_right=2 \
		label.padding_left=0 \
		label.padding_right=10 \
		icon.drawing=on \
		background.drawing=off \
		icon="$(echo "$sid" | cut -d'_' -f1)" \
		icon.font="SF Mono:Semibold:12.5" \
		click_script="aerospace workspace $sid" \
		background.corner_radius=0 \
		script="$CONFIG_DIR/plugins/aerospace.sh $sid" \
		--subscribe space."$sid" aerospace_workspace_change
done

sketchybar --set space."$first_workspace" padding_left=8
sketchybar --set space."$last_workspace" padding_right=8

sketchybar --add bracket spaces '/space\..*/' \
	--set spaces \
	background.color="${BACKGROUND}" \
	background.height=20

sketchybar --add item front_app left \
	--set front_app \
	"${GHOST[@]}" \
	script="$PLUGIN_DIR/front_app.sh" \
	--subscribe front_app front_app_switched

# --------------- RIGHT

sketchybar --add item calendar right \
	--set calendar icon="􀧞" \
	update_freq=30 \
	script="$PLUGIN_DIR/calendar.sh"

sketchybar --add item battery right \
	--set battery \
	update_freq=60 \
	script="$PLUGIN_DIR/battery.sh" \
	--subscribe battery system_woke power_source_change

# Start smart battery monitor in background
exec "$PLUGIN_DIR/battery_monitor.sh" smart-monitor &

# Start caffeinate monitor in background
exec "$PLUGIN_DIR/caffeinate_monitor.sh" smart-monitor &

sketchybar --add item wifi right \
	--set wifi \
	icon="􀴽" \
	icon.padding_right=10 \
	icon.padding_left=10 \
	label.padding_right=0 \
	script="$PLUGIN_DIR/wifi.sh" \
	click_script="$PLUGIN_DIR/wifi.sh" \
	--subscribe wifi wifi_change

sketchybar --add item claude_weekly right \
	--set claude_weekly \
	background.drawing=off \
	padding_left=0 \
	update_freq=60 \
	icon.drawing=off \
	icon.width=0 \
	icon.padding_left=0 \
	icon.padding_right=0 \
	script="$PLUGIN_DIR/openusage.sh claude Weekly"

sketchybar --add item claude_session right \
	--set claude_session \
	background.drawing=off \
	padding_left=0 \
	label.padding_right=7 \
	update_freq=60 \
	icon=":claude:" \
	icon.font="sketchybar-app-font:Regular:12.0" \
	script="$PLUGIN_DIR/openusage.sh claude Session"

sketchybar --add item claude_codex_spacer right \
	--set claude_codex_spacer \
	background.drawing=off \
	icon.drawing=off \
	label.drawing=off \
	padding_left=0 \
	padding_right=0 \
	width=5

sketchybar --add item codex_weekly right \
	--set codex_weekly \
	background.drawing=off \
	padding_left=0 \
	update_freq=60 \
	icon.drawing=off \
	icon.width=0 \
	icon.padding_left=0 \
	icon.padding_right=0 \
	script="$PLUGIN_DIR/openusage.sh codex Weekly"

sketchybar --add item codex_session right \
	--set codex_session \
	background.drawing=off \
	padding_left=0 \
	label.padding_right=7 \
	update_freq=60 \
	icon=":openai:" \
	icon.font="sketchybar-app-font:Regular:12.0" \
	script="$PLUGIN_DIR/openusage.sh codex Session"

sketchybar --add bracket claude_usage claude_session claude_weekly \
	--set claude_usage \
	background.color="${BACKGROUND}" \
	background.corner_radius=99 \
	background.height=20

sketchybar --add bracket codex_usage codex_session codex_weekly \
	--set codex_usage \
	background.color="${BACKGROUND}" \
	background.corner_radius=99 \
	background.height=20

sketchybar --add item openusage_spacer right \
	--set openusage_spacer \
	background.drawing=off \
	icon.drawing=off \
	label.drawing=off \
	padding_left=0 \
	padding_right=0 \
	width=5

sketchybar --add item linear_issues right \
	--set linear_issues \
	update_freq=300 \
	script="$PLUGIN_DIR/linear_issues.sh"

sketchybar --add item herdr_agents right \
	--set herdr_agents \
	update_freq=5 \
	script="$PLUGIN_DIR/herdr.sh"

sketchybar --add item slack right \
	--set slack \
	update_freq=5 \
	click_script="open -a 'Slack'" \
	script="$PLUGIN_DIR/slack.sh" \
	--subscribe slack system_woke

sketchybar --add event caffeinate_toggle
sketchybar --add item caffeinate right \
	--set caffeinate \
	icon="􀴽" \
	"${GHOST[@]}" \
	icon.color="${FOREGROUND}" \
	icon.padding_right=0 \
	script="$PLUGIN_DIR/caffeinate.sh" \
	--subscribe caffeinate caffeinate_toggle

sketchybar --add event send_message
sketchybar --add event hide_message
sketchybar --add item aerospace_mode right \
	--set aerospace_mode \
	"${GHOST[@]}" \
	drawing=off \
	script="$PLUGIN_DIR/aerospace_mode.sh" \
	--subscribe aerospace_mode send_message hide_message

# ------------------------------------------------------------------------------

sketchybar --update
