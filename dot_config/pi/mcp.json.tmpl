{
  "mcpServers": {
    "context7": {
      "url": "https://mcp.context7.com/mcp/oauth"
    },
    "tavily": {
      "url": "https://mcp.tavily.com/mcp/"
    },
    "posthog": {
      "url": "https://mcp.posthog.com/mcp"
    },
    "linear": {
      "url": "https://mcp.linear.app/mcp"
    },
    {{ if or (eq .chezmoi.os "darwin") (eq .chezmoi.hostname "box") -}}
    "mcpvault": {
      "command": "{{ if eq .chezmoi.os "darwin" }}{{ .chezmoi.homeDir }}/.local/share/mise/shims/bunx{{ else }}bunx{{ end }}",
      "args": ["@bitbonsai/mcpvault@latest", "{{ .chezmoi.homeDir }}/projects/personal/notes"]
    },
    {{ end -}}
    "notion": {
      "url": "https://mcp.notion.com/mcp"
    }
  }
}
