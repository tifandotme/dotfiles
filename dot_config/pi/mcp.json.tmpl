{
  "mcpServers": {
    "context7": {
      "url": "https://mcp.context7.com/mcp/oauth"
    },
    "tavily": {
      "url": "https://mcp.tavily.com/mcp/"
    },
    "posthog": {
      "url": "https://mcp.posthog.com/mcp"
    },
    "linear": {
      "url": "https://mcp.linear.app/mcp"
    },
    {{ if or (eq .chezmoi.os "darwin") (eq .chezmoi.hostname "box") -}}
    "tolaria": {
      "command": "{{ if eq .chezmoi.os "darwin" }}{{ .chezmoi.homeDir }}/.local/share/mise/shims/node{{ else }}node{{ end }}",
      "args": ["{{ .chezmoi.homeDir }}/.local/share/tolaria-mcp/mcp-server/index.js"],
      "env": {
        {{ if eq .chezmoi.hostname "box" -}}
        "VAULT_PATH": "{{ .chezmoi.homeDir }}/projects/personal/notes",
        {{ end -}}
        "WS_UI_PORT": "9711"
      }
    },
    {{ end -}}
    "notion": {
      "url": "https://mcp.notion.com/mcp"
    }
  }
}
