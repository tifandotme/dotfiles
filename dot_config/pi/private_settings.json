    "../../projects/personal/pi-extensions/packages/pi-preferred-thinking",
    "../../projects/personal/pi-extensions/packages/pi-recap",
    "../../projects/personal/pi-extensions/packages/pi-rename",
    "../../projects/personal/pi-extensions/packages/pi-stash",
    "../../projects/personal/pi-extensions/packages/pi-inline-skills",
    "../../projects/personal/pi-extensions/packages/pi-mermaid-open",
    "../../projects/personal/pi-extensions/packages/pi-review",
    "npm:pi-add-dir",
    "npm:pi-codex-goal",
    "npm:pi-rtk-optimizer",
    "npm:pi-mcp-adapter",
    "npm:pi-subdir-context",
    "npm:@ff-labs/pi-fff@nightly",
