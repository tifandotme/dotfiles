#!/usr/bin/env bash
#MISE description="Start missing database tunnels and keep them running"
#MISE dir="{{cwd}}"
set -Eeuo pipefail

ports=(5433 5434 5435)
tasks=(tunnel-windmill tunnel-staging tunnel-prod)
pids=()

for index in "${!ports[@]}"; do
	port=${ports[$index]}
	task=${tasks[$index]}
	if lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
		echo "Tunnel already listening on localhost:$port" >&2
		continue
	fi

	mise run "$task" &
	pids+=("$!")
done

if ((${#pids[@]} == 0)); then
	echo "All DB tunnels are already listening" >&2
	exit 0
fi

status=0
for pid in "${pids[@]}"; do
	if ! wait "$pid"; then
		status=1
	fi
done
exit "$status"
