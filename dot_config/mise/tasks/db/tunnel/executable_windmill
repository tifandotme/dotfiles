#!/usr/bin/env bash
#MISE description="Open the internal DB tunnel via backoffice-windmill"
#MISE dir="{{cwd}}"
#MISE raw=true
#MISE quiet=true
#USAGE flag "-h --help" help="Print help"
set -Eeuo pipefail

echo "localhost:5433" >&2
exec gcloud --account=tifan@hadl.ai compute ssh \
	--zone asia-southeast1-c backoffice-windmill \
	--project backoffice-windmill \
	--tunnel-through-iap \
	-- -L 5433:172.16.0.3:5432 -N
