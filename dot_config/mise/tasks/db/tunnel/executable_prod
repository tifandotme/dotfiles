#!/usr/bin/env bash
#MISE description="Open the production DB tunnel"
#MISE dir="{{cwd}}"
#MISE raw=true
#MISE quiet=true
#USAGE flag "-h --help" help="Print help"
set -Eeuo pipefail

echo "localhost:5435" >&2
exec gcloud --account=tifan@hadl.ai compute ssh aquasense-prod \
	--project aquasense-production \
	--tunnel-through-iap \
	--zone asia-southeast1-a \
	-- -L 5435:10.2.0.3:5432 -N
