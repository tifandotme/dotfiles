#!/usr/bin/env bash
#MISE description="Open the Aquasense staging DB tunnel"
#MISE dir="{{cwd}}"
#MISE raw=true
#MISE quiet=true
#USAGE flag "-h --help" help="Print help"
set -Eeuo pipefail

echo "localhost:5434" >&2
exec gcloud --account=tifan@hadl.ai compute ssh \
	--zone asia-southeast1-c aqusense-staging \
	--project aquasense-staging \
	--tunnel-through-iap \
	-- -L 5434:172.16.0.3:5432 -N
