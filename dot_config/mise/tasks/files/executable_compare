#!/usr/bin/env bash
#MISE description="Pick two files and compare them with difft"
#MISE dir="{{cwd}}"
#MISE raw=true
#MISE quiet=true
set -Eeuo pipefail

files() {
	if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
		git ls-files --others --exclude-standard --cached -z
	else
		find . -type f -print0
	fi
}

IFS= read -r -d '' first < <(files | fzf --read0 --print0 --header='Choose a file') || exit 0

IFS= read -r -d '' second < <(files | while IFS= read -r -d '' file; do
	[[ $file == "$first" ]] || printf '%s\0' "$file"
done | fzf --read0 --print0 --header='Choose another file to diff') || exit 0

exec difft "$first" "$second" --syntax-highlight=off
