#!/usr/bin/env bash
#MISE description="Show all Box agent sessions"
#MISE dir="{{cwd}}"
#MISE raw=true
#MISE quiet=true
#USAGE flag "-h --help" help="Print help"
set -Eeuo pipefail

command -v tmux >/dev/null
failed=0
printf '%-22s %-40s %s\n' AGENT 'TMUX SESSION' STATUS
for agent in amp chezmoi aquasense-app aquasense-service backoffice-windmill core-service gcp-terraform kamal-deploy; do
	session="box-claude-$agent"
	[[ $agent != amp ]] || session=box-amp
	if ! tmux has-session -t "$session" 2>/dev/null; then
		status='not running'
	else
		pane_status=$(tmux display-message -p -t "$session" '#{pane_dead}:#{pane_current_command}')
		case $pane_status in
		0:*) status="running (${pane_status#*:})" ;;
		1:*) status='process exited (tmux session remains)' ;;
		*)
			status=unknown
			failed=1
			;;
		esac
	fi
	printf '%-22s %-40s %s\n' "$agent" "$session" "$status"
done
exit "$failed"
