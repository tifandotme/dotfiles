#!/usr/bin/env bash
#MISE description="Start a Box Amp runner tmux session"
#MISE dir="{{cwd}}"
#MISE raw=true
#MISE quiet=true
#USAGE arg "<profile>" {
#USAGE   choices "personal" "work"
#USAGE }
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/../lib.sh"

profile=${usage_profile?}
case $profile in
personal)
	cwd="$HOME/.local/share/chezmoi"
	runner_id=box
	discover_dir="$HOME/projects/personal"
	;;
work)
	cwd="$HOME/projects/work"
	runner_id=box-hadl
	discover_dir=$cwd
	;;
esac
command -v amp >/dev/null
[[ -d $discover_dir ]] || fail "Missing directory: $discover_dir"
printf -v launch 'exec mise exec -- amp --no-tui --runner-id=%q --no-serve-cwd --discover-dirs=%q --dir=%q' \
	"$runner_id" "$discover_dir" "$cwd"
start_session "box-amp-$profile" "$cwd" "$launch"
