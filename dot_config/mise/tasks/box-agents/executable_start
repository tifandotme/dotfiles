#!/usr/bin/env bash
#MISE description="Start a Box agent tmux session"
#MISE dir="{{cwd}}"
#MISE raw=true
#MISE quiet=true
#USAGE arg "<agent>" {
#USAGE   choices "amp" "chezmoi" "aquasense-app" "aquasense-service" "backoffice-windmill" "core-service" "gcp-terraform" "kamal-deploy"
#USAGE }
set -Eeuo pipefail

agent=${usage_agent?}
session="box-claude-$agent"
cwd="$HOME/projects/work/$agent"
if [[ $agent == amp || $agent == chezmoi ]]; then
	cwd="$HOME/.local/share/chezmoi"
fi
if [[ $agent == amp ]]; then
	session=box-amp
	command -v amp >/dev/null
	[[ -d $HOME/projects/personal ]] || {
		printf 'Missing directory: %s\n' "$HOME/projects/personal" >&2
		exit 1
	}
	# tmux expands HOME in its launch shell.
	# shellcheck disable=SC2016
	launch='exec amp --no-tui --runner-id=box --no-serve-cwd --discover-dirs="$HOME/projects/personal" --dir="$HOME/.local/share/chezmoi"'
else
	command -v claude >/dev/null
	# Keep Claude sessions inside tmux so Herdr sees tmux instead of Claude.
	launch='exec claude remote-control --permission-mode=bypassPermissions --spawn=same-dir --capacity=10 --no-chrome'
fi
[[ -d $cwd ]] || {
	printf 'Missing directory: %s\n' "$cwd" >&2
	exit 1
}
command -v tmux >/dev/null
if tmux has-session -t "$session" 2>/dev/null; then
	printf '%s is already running (attach with: tmux attach -t %s)\n' "$session" "$session"
	exit 0
fi
tmux new-session -d -s "$session" -c "$cwd" "$launch"
printf 'Started %s (attach with: tmux attach -t %s)\n' "$session" "$session"
