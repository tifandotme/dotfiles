#!/usr/bin/env bash
#MISE description="Show Claude Code extra usage"
#MISE dir="{{cwd}}"
#MISE raw=true
#MISE quiet=true
set -Eeuo pipefail

readonly API_URL='https://api.anthropic.com/api/oauth/usage'
readonly BETA_HEADER='oauth-2025-04-20'
readonly USER_AGENT='claude-code/2.1.0'
readonly KEYCHAIN_SERVICE='Claude Code-credentials'

die() {
	printf 'error: %s\n' "$*" >&2
	exit 1
}

require_cmd() {
	command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"
}

read_access_token() {
	local service
	local payload
	local account="${CODEXBAR_CLAUDE_KEYCHAIN_ACCOUNT:-}"
	local -a args
	local -a services=("$KEYCHAIN_SERVICE")

	while IFS= read -r service; do
		services+=("$service")
	done < <(security dump-keychain 2>/dev/null |
		grep -o "\"${KEYCHAIN_SERVICE}-[^\"]*\"" |
		tr -d '"' || true)

	{
		for service in "${services[@]}"; do
			args=(find-generic-password -s "$service" -w)
			[[ -n "$account" ]] && args+=(-a "$account")
			if payload="$(security "${args[@]}" 2>/dev/null)"; then
				printf '%s\0' "$payload"
			fi
		done
	} | python3 -c '
import json
import math
import sys
import time

def find_tokens(value):
    if isinstance(value, dict):
        expiry = value.get("expiresAt")
        if isinstance(expiry, (int, float)) and not isinstance(expiry, bool):
            expiry = float(expiry)
            if math.isfinite(expiry) and expiry > time.time() * 1000:
                for key in ("accessToken", "access_token"):
                    token = value.get(key)
                    if isinstance(token, str) and token.strip():
                        yield expiry, token.strip()
        else:
            for key in ("accessToken", "access_token"):
                token = value.get(key)
                if isinstance(token, str) and token.strip():
                    yield 0, token.strip()
        for nested in value.values():
            if isinstance(nested, (dict, list)):
                yield from find_tokens(nested)
    elif isinstance(value, list):
        for nested in value:
            yield from find_tokens(nested)


candidates = []
for raw in sys.stdin.buffer.read().split(b"\0"):
    payload = raw.decode("utf-8", errors="replace").strip()
    if not payload:
        continue
    try:
        value = json.loads(payload)
    except json.JSONDecodeError:
        candidates.append((0, payload))
    else:
        candidates.extend(find_tokens(value))

if candidates:
    print(max(candidates, key=lambda candidate: candidate[0])[1])
else:
    raise SystemExit(1)
'
}

response_body=''

cleanup() {
	if [[ -n "${response_body:-}" ]]; then
		rm -f -- "$response_body"
	fi
}

main() {
	require_cmd curl
	require_cmd python3
	require_cmd security

	local token
	local http_code

	trap cleanup EXIT

	token="$(read_access_token)" || die "could not find an unexpired Claude OAuth access token in Keychain"

	response_body="$(mktemp)"

	http_code="$(curl -sS \
		-o "$response_body" \
		-w '%{http_code}' \
		-H "Authorization: Bearer ${token}" \
		-H 'Accept: application/json' \
		-H "anthropic-beta: ${BETA_HEADER}" \
		-H "User-Agent: ${USER_AGENT}" \
		"$API_URL")"

	if [[ "$http_code" != '200' ]]; then
		if [[ "$http_code" == '401' ]]; then
			die 'Claude OAuth token rejected by Anthropic. The Keychain item may be stale, wrong, or missing the needed scope.'
		fi
		die "Claude OAuth request failed: HTTP $http_code"
	fi

	python3 -c '
import json
import sys

with open(sys.argv[1], encoding="utf-8") as fh:
    data = json.load(fh)

extra = data.get("extra_usage")
if not extra:
    print("extra_usage: unavailable")
    raise SystemExit(0)

def cents_to_dollars(value):
    if value is None:
        return "0.00"
    return f"{float(value) / 100:.2f}"

currency = extra.get("currency") or "USD"
enabled = str(bool(extra.get("is_enabled"))).lower()
used = cents_to_dollars(extra.get("used_credits"))
limit = cents_to_dollars(extra.get("monthly_limit"))
print(f"extra_usage used={used} limit={limit} currency={currency} enabled={enabled}")
' "$response_body"
}

main "$@"
