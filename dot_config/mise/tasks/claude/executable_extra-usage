#!/usr/bin/env bash
#MISE description="Show Claude Code extra usage"
#MISE dir="{{cwd}}"
#MISE raw=true
#MISE quiet=true
set -Eeuo pipefail

readonly API_URL='https://api.anthropic.com/api/oauth/usage'
readonly BETA_HEADER='oauth-2025-04-20'
readonly USER_AGENT='claude-code/2.1.0'
readonly KEYCHAIN_SERVICE='Claude Code-credentials'

die() {
	printf 'error: %s\n' "$*" >&2
	exit 1
}

require_cmd() {
	command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"
}

read_access_token() {
	local service="$KEYCHAIN_SERVICE"
	local account="${CODEXBAR_CLAUDE_KEYCHAIN_ACCOUNT:-}"
	local -a args

	# Claude hashes the exact explicit config path, including any trailing slash.
	if [[ -n "${CLAUDE_CONFIG_DIR:-}" ]]; then
		service+="-$(bun -e 'console.log(new Bun.CryptoHasher("sha256").update(process.env.CLAUDE_CONFIG_DIR).digest("hex").slice(0, 8))')" || return 1
	fi
	args=(find-generic-password -s "$service" -w)
	[[ -n "$account" ]] && args+=(-a "$account")
	security "${args[@]}" 2>/dev/null | bun -e '
try {
    const oauth = JSON.parse(await Bun.stdin.text()).claudeAiOauth;
    const token = oauth?.accessToken;
    if (typeof token !== "string" || !token.trim() ||
        (oauth.expiresAt != null && (!Number.isFinite(oauth.expiresAt) || oauth.expiresAt <= Date.now()))) process.exit(1);
    console.log(token.trim());
} catch {
    process.exit(1);
}
'
}

response_body=''

cleanup() {
	if [[ -n "${response_body:-}" ]]; then
		rm -f -- "$response_body"
	fi
}

main() {
	require_cmd curl
	require_cmd bun
	require_cmd python3
	require_cmd security

	local token
	local http_code

	trap cleanup EXIT

	token="$(read_access_token)" || die "could not find an unexpired Claude OAuth access token in Keychain for the selected CLAUDE_CONFIG_DIR"

	response_body="$(mktemp)"

	http_code="$(curl -sS \
		-o "$response_body" \
		-w '%{http_code}' \
		-H "Authorization: Bearer ${token}" \
		-H 'Accept: application/json' \
		-H "anthropic-beta: ${BETA_HEADER}" \
		-H "User-Agent: ${USER_AGENT}" \
		"$API_URL")"

	if [[ "$http_code" != '200' ]]; then
		if [[ "$http_code" == '401' ]]; then
			die 'Claude OAuth token rejected by Anthropic. The Keychain item may be stale, wrong, or missing the needed scope.'
		fi
		die "Claude OAuth request failed: HTTP $http_code"
	fi

	python3 -c '
import json
import sys

with open(sys.argv[1], encoding="utf-8") as fh:
    data = json.load(fh)

extra = data.get("extra_usage")
if not extra:
    print("extra_usage: unavailable")
    raise SystemExit(0)

def cents_to_dollars(value):
    if value is None:
        return "0.00"
    return f"{float(value) / 100:.2f}"

currency = extra.get("currency") or "USD"
enabled = str(bool(extra.get("is_enabled"))).lower()
used = cents_to_dollars(extra.get("used_credits"))
limit = cents_to_dollars(extra.get("monthly_limit"))
print(f"extra_usage used={used} limit={limit} currency={currency} enabled={enabled}")
' "$response_body"
}

main "$@"
