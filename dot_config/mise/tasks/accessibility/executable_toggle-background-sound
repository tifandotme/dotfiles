#!/usr/bin/env bash
#MISE description="Toggle macOS accessibility background sounds"
#MISE dir="{{cwd}}"

set -Eeuo pipefail

domain=com.apple.ComfortSounds
key=comfortSoundsEnabled

if [ "$(/usr/bin/defaults read "$domain" "$key" 2>/dev/null || echo 0)" = 1 ]; then
	/usr/bin/defaults write "$domain" "$key" -bool false
else
	/usr/bin/defaults write "$domain" "$key" -bool true
fi
