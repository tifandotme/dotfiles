#!/usr/bin/env bash
#MISE description="Re-add, review, commit, and push chezmoi changes"
#MISE dir="{{cwd}}"
#MISE raw=true
#MISE quiet=true
#USAGE flag "-h --help" help="Print help"
set -Eeuo pipefail

chezmoi re-add
if [[ -n $(chezmoi status) ]]; then
	chezmoi diff
	chezmoi status
	printf '%s\n' 'Run chezmoi edit --apply <file> on each template first, then retry.' >&2
	exit 1
fi

chezmoi git -- commit -am 'chore: update'
chezmoi git push
