#!/usr/bin/env bash
#MISE description="Stop an Amp runner tmux session"
#MISE dir="{{cwd}}"
#MISE raw=true
#MISE quiet=true
#USAGE arg "<profile>" {
#USAGE   choices "personal" "work"
#USAGE }
set -Eeuo pipefail
# shellcheck source=lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

session="$(agent_machine)-amp-${usage_profile?}"
command -v tmux >/dev/null
if tmux has-session -t "=$session" 2>/dev/null; then
	tmux kill-session -t "=$session"
	printf 'Stopped %s\n' "$session"
else
	printf '%s is not running\n' "$session"
fi
