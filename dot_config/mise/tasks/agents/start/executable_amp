#!/usr/bin/env bash
#MISE description="Start an Amp runner tmux session"
#MISE dir="{{cwd}}"
#MISE raw=true
#MISE quiet=true
#USAGE arg "<profile>" {
#USAGE   choices "personal" "work"
#USAGE }
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/../lib.sh"

profile=${usage_profile?}
machine=$(agent_machine)
case $profile in
personal)
	cwd="$HOME/.local/share/chezmoi"
	discover_dir="$HOME/projects/personal"
	;;
work)
	cwd="$HOME/projects/work"
	discover_dir=$cwd
	;;
esac
runner_id=$machine
command -v amp >/dev/null
[[ -d $discover_dir ]] || fail "Missing directory: $discover_dir"
printf -v launch 'while :; do mise exec -- amp --no-tui --remote-control-portals --runner-id=%q --no-serve-cwd --discover-dirs=%q --dir=%q; status=$?; printf "Amp exited (%%s); restarting in 5 seconds\n" "$status"; sleep 5; done' \
	"$runner_id" "$discover_dir" "$cwd"
start_session "$machine-amp-$profile" "$cwd" "$launch"
