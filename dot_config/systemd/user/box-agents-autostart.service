[Unit]
Description=Start Box Amp runners in tmux

[Service]
Type=oneshot
Environment="PATH=%h/.local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/linuxbrew/.linuxbrew/bin/mise run --quiet --raw agents:start personal
ExecStart=/home/linuxbrew/.linuxbrew/bin/mise run --quiet --raw agents:start work
RemainAfterExit=yes

[Install]
WantedBy=default.target
