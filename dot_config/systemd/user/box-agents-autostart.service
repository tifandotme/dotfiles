[Unit]
Description=Start selected Box agents in tmux

[Service]
Type=oneshot
Environment="PATH=%h/.local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/.local/bin/box-agents start amp
ExecStart=%h/.local/bin/box-agents start backoffice-windmill
RemainAfterExit=yes

[Install]
WantedBy=default.target
