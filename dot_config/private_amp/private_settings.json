{
  "amp.terminal.theme": "terminal",
  "amp.git.commit.coauthor.enabled": false,
  "amp.git.commit.ampThread.enabled": true,

  "amp.skills.disableClaudeCodeSkills": true,
  "amp.mcpServers": {},
  "amp.dangerouslyAllowAll": true,
  "amp.openai.speed": "standard",
  "amp.gauge": "cost",

  "amp.keymap": {
    "leader": "ctrl+x",
    "amp.quit": "ctrl+c ctrl+c",
    "mode.toggle": "ctrl+l",
    "mode.toggleReasoningEffort": "shift+tab",
    "news.open": null,
    "prompt.clear": null,
    "prompt.copySelection": null,
    "prompt.dequeue": null,
    "prompt.history": "ctrl+r",
    "prompt.openInEditor": "ctrl+g",
    "prompt.pasteImageFromClipboard": "ctrl+v",
    "prompt.steerQueuedMessage": null,
    "settings.openInEditor": null,
    "skills.list": null,
    "speed.toggleFast": "alt+r",
    "thread.analyzeContext": null,
    "thread.archive": "ctrl+c ctrl+n",
    "thread.archiveAndQuit": "ctrl+c ctrl+e",
    "thread.copyID": null,
    "thread.copyMarkdown": null,
    "thread.copyURL": null,
    "thread.mention": null,
    "thread.new": null,
    "thread.newRemote": "<leader>r",
    "thread.switchToNextInSidebar": null,
    "thread.switchToPrevious": null,
    "thread.switchToPreviousInSidebar": "ctrl+alt+up",
    "thread.toggleDetails": "ctrl+o",
    "thread.toggleOutline": null,
    "thread.toggleSidebar": null
  },
  "amp.remoteThreadCreation.enabled": false
}
