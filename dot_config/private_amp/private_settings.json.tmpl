{
  "$schema": "https://ampcode.com/cli-settings.schema.json",
  "amp.terminal.theme": "terminal",
  "amp.git.commit.coauthor.enabled": false,
  "amp.git.commit.ampThread.enabled": true,
  "amp.remoteThreadCreation.enabled": false,
  "amp.skills.disableClaudeCodeSkills": true,
  "amp.dangerouslyAllowAll": true,
  "amp.gauge": "tokens",

  "amp.keymap": {
    "leader": "ctrl+x",
    "amp.quit": "ctrl+c ctrl+c",
    "mode.toggle": "ctrl+l",
    "mode.toggleReasoningEffort": "shift+tab",
    "news.open": null,
    "prompt.clear": null,
    "prompt.copySelection": null,
    "prompt.dequeue": null,
    "prompt.history": "ctrl+r",
    // Ctrl+G does not open $EDITOR in amp 0.0.1794110442-ga8fc4f. Bug report amp_bug_6EMZKeWgp0YUXYdVC6ZYLM: pending.
    "prompt.openInEditor": "ctrl+g",
    "prompt.pasteImageFromClipboard": "ctrl+v",
    "prompt.queue": "ctrl+enter",
    "prompt.steerQueuedMessage": null,
    "settings.openInEditor": null,
    "skills.list": null,
    "speed.toggleFast": "alt+r",
    "thread.analyzeContext": null,
    "thread.archive": "ctrl+c ctrl+n",
    "thread.archiveAndQuit": "ctrl+c ctrl+e",
    "thread.copyID": null,
    "thread.copyMarkdown": null,
    "thread.copyURL": null,
    "thread.mention": null,
    "thread.new": null,
    "thread.newRemote": "<leader>r",
    "thread.switchToNextInSidebar": null,
    "thread.switchToPrevious": null,
    "thread.switchToPreviousInSidebar": "ctrl+alt+up",
    "thread.toggleDetails": "ctrl+shift+o",
    "thread.toggleOutline": null,
    "thread.toggleSidebar": null
  },
  {{ if or (eq .chezmoi.os "darwin") (eq .chezmoi.hostname "box") -}}
  "amp.mcpServers": {
    "whatsapp": {
      "url": "http://box.javanese-pound.ts.net:8765/sse",
      "transport": "sse"
    },
    {{ if eq .chezmoi.os "darwin" -}}
    "openpencil": {
      "command": "{{ .chezmoi.homeDir }}/.local/share/mise/shims/node",
      "args": ["{{ .chezmoi.homeDir }}/.local/share/bun/bin/openpencil-mcp"]
    },
    {{ end -}}
    "tolaria": {
      "command": "{{ if eq .chezmoi.os "darwin" }}{{ .chezmoi.homeDir }}/.local/share/mise/shims/node{{ else }}node{{ end }}",
      "args": [
        "{{ .chezmoi.homeDir }}/.local/share/tolaria-mcp/mcp-server/index.js"
      ],
      "env": {
        {{ if eq .chezmoi.hostname "box" -}}
        "VAULT_PATH": "{{ .chezmoi.homeDir }}/projects/personal/notes",
        {{ end -}}
        "WS_UI_PORT": "9711"
      }
    }
  },
  {{ end -}}
  "amp.workspaces": [
    {
      "path": "/Users/tifan/projects/personal/box",
      "allowAllMcpServers": true
    }
  ],
  "amp.mcpTrustedServers": [
    {
      "serverName": "n8n",
      "specHash": "4d0f0da048736cd31f96ac052a5d5989e793fa690344752c01acb0f87d3af3bc",
      "allow": true
    }
  ]
}
