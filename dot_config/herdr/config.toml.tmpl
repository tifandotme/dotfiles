# chezmoi:template:left-delimiter="# {{" right-delimiter=}}
# {{ $palette := fromJson (include "dot_config/theme/palette.json") }}

onboarding = false

[terminal]
# {{ if eq .chezmoi.os "linux" -}}
default_shell = "/home/linuxbrew/.linuxbrew/bin/nu"
# {{ else -}}
default_shell = "nu"
# {{- end }}

[keys]
prefix = "ctrl+e"
new_workspace = "super+n"
rename_workspace = "super+shift+r"
close_workspace = "super+x"
close_tab = "super+shift+w"
new_tab = "super+t"
rename_tab = "super+r"
split_vertical = "prefix+|"
split_horizontal = "prefix+-"
close_pane = "super+w"
zoom = "prefix+f"
resize_mode = "prefix+r"
toggle_sidebar = "prefix+b"
reload_config = "prefix+shift+r"
previous_workspace = "super+shift+["
next_workspace = "super+shift+]"
previous_tab = "super+["
next_tab = "super+]"
previous_agent = "alt+["
next_agent = "alt+]"
switch_workspace = "alt+shift+1..9"
switch_tab = "alt+1..9"
focus_pane_left = "alt+h"
focus_pane_down = "alt+j"
focus_pane_up = "alt+k"
focus_pane_right = "alt+l"
edit_scrollback = "prefix+e"

[[keys.command]]
key = "super+b"
type = "popup"
command = "nu -c 'source ~/.config/nushell/scripts/core.nu; source ~/.config/nushell/scripts/project.nu; open-project'"
width = "90%"
height = "90%"
description = "open worktree picker"

[[keys.command]]
key = "super+shift+c"
type = "popup"
command = "nu -c 'source ~/.config/nushell/scripts/chezmoi.nu; chezmoi-apply-popup'"
width = "90%"
height = "90%"
description = "apply chezmoi changes"

[[keys.command]]
key = "prefix+l"
type = "popup"
command = "lazygit"
width = "90%"
height = "90%"
description = "open lazygit"

[ui]
prompt_new_tab_name = false
mouse_capture = true
confirm_close = true

agent_panel_sort = "priority"

status_indicators = "dots"
[ui.sidebar.spaces]
row_gap = 0
rows = [
  ["state_icon", "workspace"],
  [{ token = "branch", dim = true }, "git_status"],
]

[ui.sidebar.agents]
row_gap = 0
rows = [
  ["state_icon", { token = "pane", dim = false }],
  ["state_text", "agent"],
]

[ui.toast]
delivery = "terminal"

[theme]
name = "terminal"

[theme.custom]
accent = "{{ $palette.accent }}"

[experimental]
kitty_graphics = true
pane_history = true
