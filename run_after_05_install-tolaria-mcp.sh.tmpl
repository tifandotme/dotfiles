#!/usr/bin/env bash

set -Eeuo pipefail

# chezmoi:template:left-delimiter="# {{" right-delimiter=}}
tolaria_dir="$HOME/.local/share/tolaria-mcp/mcp-server"
# {{ if eq .chezmoi.hostname "box" -}}
vault_path="$HOME/projects/personal/notes"

if [[ ! -d "$vault_path" ]]; then
	printf 'Tolaria vault is missing: %s\n' "$vault_path" >&2
	exit 1
fi
# {{ end -}}

if ! command -v bun >/dev/null 2>&1; then
	printf '%s\n' 'bun is required to install Tolaria MCP dependencies' >&2
	exit 1
fi

cd "$tolaria_dir"
# {{ if eq .chezmoi.os "darwin" -}}
lock_hash="$(shasum -a 256 package.json package-lock.json | shasum -a 256 | awk '{print $1}')"
# {{ else -}}
lock_hash="$(sha256sum package.json package-lock.json | sha256sum | awk '{print $1}')"
# {{ end -}}
installed_hash=""
if [[ -f .chezmoi-package-lock-hash ]]; then
	installed_hash="$(<.chezmoi-package-lock-hash)"
fi

if [[ ! -d node_modules || "$installed_hash" != "$lock_hash" ]]; then
	install_dir="$(mktemp -d "$tolaria_dir/.install.XXXXXXXX")"
	trap '
		if [[ ( -e "$install_dir/previous-node_modules" || -L "$install_dir/previous-node_modules" ) && ! -e node_modules && ! -L node_modules ]]; then
			mv "$install_dir/previous-node_modules" node_modules || exit 1
		fi
		rm -rf "$install_dir"
	' EXIT
	cp package.json package-lock.json "$install_dir/"
	if bun install --cwd "$install_dir" --no-save --production >"$install_dir/bun.log" 2>&1; then
		cat "$install_dir/bun.log"
	else
		cat "$install_dir/bun.log" >&2
		# Remove this workaround when https://github.com/refactoringhq/tolaria/issues/1303 is fixed.
		if ! grep -Fq 'lockfile had changes, but lockfile is frozen' "$install_dir/bun.log"; then
			exit 1
		fi
		if ! command -v npm >/dev/null 2>&1; then
			printf '%s\n' 'npm is required to repair the Tolaria MCP lockfile' >&2
			exit 1
		fi
		(cd "$install_dir" && npm install --package-lock-only --ignore-scripts --no-audit --no-fund)
		bun install --cwd "$install_dir" --no-save --production
	fi
	if [[ -e node_modules || -L node_modules ]]; then
		mv node_modules "$install_dir/previous-node_modules"
	fi
	mv "$install_dir/node_modules" node_modules
	printf '%s\n' "$lock_hash" >.chezmoi-package-lock-hash.tmp
	mv .chezmoi-package-lock-hash.tmp .chezmoi-package-lock-hash
fi
