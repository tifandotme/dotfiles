#!/usr/bin/env bash

# chezmoi:template:left-delimiter="# {{" right-delimiter=}}
set -Eeuo pipefail

if command -v bun &>/dev/null; then
	normalize_bun_pkg() {
		local pkg="$1"

		if [[ "$pkg" =~ ^(@[^/]+/[^@]+)@.+$ ]]; then
			printf '%s\n' "${BASH_REMATCH[1]}"
		elif [[ "$pkg" =~ ^([^@]+)@.+$ ]]; then
			printf '%s\n' "${BASH_REMATCH[1]}"
		else
			printf '%s\n' "$pkg"
		fi
	}

	desired_bun_packages=(
		# macOS-only packaging tools
		# {{ if eq .chezmoi.os "darwin" -}}
		# {{ end -}}

		# updater
		"npm-check-updates"
		"actions-up"

		# system
		"port-whisperer"

		# devtools
		"@effect/language-service"
		"@vtsls/language-server"
		"bash-language-server"
		"vscode-langservers-extracted"
		"yaml-language-server"
		"typescript"
		"oxfmt"
		"oxlint"
		"@dotenvx/dotenvx"
		"vercel"
		"portless"
		"eas-cli"

		# agent-stuff
		"skills"
		"@earendil-works/pi-coding-agent"
		"agent-browser"
		"ccstatusline"

		# apps clis
		"@actual-app/cli"
		"@bitwarden/cli"
		"@steipete/bird"

		# VPS-only tools
		# {{ if eq .chezmoi.hostname "box" -}}
		# {{- end }}
	)

	is_versioned_bun_pkg() {
		local pkg="$1"

		[[ "$pkg" =~ ^(@[^/]+/[^@]+)@.+$ ]] || [[ "$pkg" =~ ^([^@]+)@.+$ ]]
	}

	desired_bun_package_names=()
	for pkg in "${desired_bun_packages[@]}"; do
		desired_bun_package_names+=("$(normalize_bun_pkg "$pkg")")
	done

	# --json request to avoid the mess below: https://github.com/oven-sh/bun/issues/26222
	installed_packages=$(bun pm ls -g 2>/dev/null | grep -E '^├──|^└──' | sed -E 's/^[├└]── //' | while read -r pkg; do normalize_bun_pkg "$pkg"; done | sort || true)

	for pkg in "${desired_bun_packages[@]}"; do
		if is_versioned_bun_pkg "$pkg"; then
			echo "Installing bun global package: $pkg"
			bun add -g "$pkg"
			continue
		fi

		normalized_pkg=$(normalize_bun_pkg "$pkg")
		if ! printf '%s\n' "$installed_packages" | grep -qxF "$normalized_pkg"; then
			echo "Installing bun global package: $pkg"
			bun add -g "$pkg"
		fi
	done

	while IFS= read -r pkg; do
		if [[ -n "$pkg" ]] && ! printf '%s\n' "${desired_bun_package_names[@]}" | grep -qxF "$pkg"; then
			echo "Removing unwanted bun global package: $pkg"
			bun remove -g "$pkg"
		fi
	done <<<"$installed_packages"

	# {{ if eq .chezmoi.hostname "box" -}}
	if ! command -v agent-browser >/dev/null 2>&1; then
		printf '%s\n' 'agent-browser is missing after Bun package synchronization' >&2
		exit 1
	fi
	agent-browser install --with-deps
	# {{- end }}
fi
