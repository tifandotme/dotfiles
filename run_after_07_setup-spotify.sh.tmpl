#!/usr/bin/env bash
set -Eeuo pipefail

token_file="$HOME/.cache/sketchybar/spotify_token.json"
if [[ -f "$token_file" ]]; then
	exit 0
fi

if [[ ! -t 0 || ! -t 1 ]]; then
	printf '%s\n' 'Spotify token is missing. Run mise run spotify:login in an interactive terminal.' >&2
	exit 0
fi

if ! mise run --quiet --raw spotify:login; then
	printf '%s\n' 'Spotify setup did not complete; rerun chezmoi apply or mise run spotify:login later.' >&2
fi
