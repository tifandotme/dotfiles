# shellcheck shell=bash
# shellcheck source=/dev/null

# Load shared environment settings.
[ -f "$HOME/.profile" ] && . "$HOME/.profile"

# Skip interactive setup for scripts and other non-interactive shells.
[[ $- == *i* ]] || return

# History and command-line editing.
mkdir -p "$XDG_STATE_HOME/bash"
HISTFILE="$XDG_STATE_HOME/bash/history"
HISTSIZE=100000
HISTFILESIZE=100000
HISTCONTROL=ignoredups
shopt -s histappend
PROMPT_COMMAND='history -a; history -n'

set -o vi

# Make Ctrl-L clear the screen in both vi keymaps.
bind -m vi-command '"\C-l": clear-screen'
bind -m vi-insert '"\C-l": clear-screen'

# Load completions from Homebrew or the system package.
if [[ -r "$HOMEBREW_PREFIX/etc/profile.d/bash_completion.sh" ]]; then
	# shellcheck source=/dev/null
	. "$HOMEBREW_PREFIX/etc/profile.d/bash_completion.sh"
elif [[ -r /usr/share/bash-completion/bash_completion ]]; then
	# shellcheck source=/dev/null
	. /usr/share/bash-completion/bash_completion
fi

# Load shared aliases, functions, and workflow commands.
# shellcheck source=/dev/null
. "$XDG_CONFIG_HOME/shell/interactive.sh"

# Point GPG pinentry at the current terminal.
if [[ -t 0 ]]; then
	GPG_TTY=$(tty)
	export GPG_TTY
fi

# Enable integrations only when their commands are installed.
command -v fzf >/dev/null && eval "$(fzf --bash)"

command -v zoxide >/dev/null && eval "$(zoxide init bash --cmd cd)"

command -v mise >/dev/null && eval "$(mise activate bash)"

command -v starship >/dev/null && eval "$(starship init bash)"
