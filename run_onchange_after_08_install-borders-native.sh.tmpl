#!/usr/bin/env bash

set -Eeuo pipefail

# Install the upstream source at a pinned commit; do not vendor it in this repository.
readonly repository="https://github.com/krashnakant/borders-native.git"
readonly revision="b60077b143cb6503765b330c72bf2254507f5236"
readonly install_prefix="$HOME/.local"
uid="$(/usr/bin/id -u)"
readonly launch_service="gui/$uid/local.borders-native"

if /bin/launchctl print "$launch_service" >/dev/null 2>&1; then
	/bin/launchctl bootout "$launch_service"
fi

temporary_directory="$(mktemp -d "${TMPDIR:-/tmp}/borders-native.XXXXXX")"
trap 'rm -rf -- "$temporary_directory"' EXIT

source_directory="$temporary_directory/source"
/usr/bin/git init --quiet "$source_directory"
/usr/bin/git -C "$source_directory" remote add origin "$repository"
/usr/bin/git -C "$source_directory" fetch --quiet --depth=1 origin "$revision"
/usr/bin/git -C "$source_directory" checkout --quiet --detach FETCH_HEAD

actual_revision="$(/usr/bin/git -C "$source_directory" rev-parse HEAD)"
if [[ "$actual_revision" != "$revision" ]]; then
	printf 'Expected borders-native %s, got %s\n' "$revision" "$actual_revision" >&2
	exit 1
fi

# Local fix: retry accessibility registration for apps that are still launching.
# Without it, apps started after borders-native never report focus changes between their windows.
# Upstream PR: https://github.com/krashnakant/borders-native/pull/1 (drop this patch once it is merged and the pin is bumped)
/usr/bin/git -C "$source_directory" apply <<'PATCH'
diff --git a/borders.swift b/borders.swift
index c36f84a..a79e68f 100644
--- a/borders.swift
+++ b/borders.swift
@@ -249,7 +249,11 @@ func observe(_ a: NSRunningApplication) {
   var o: AXObserver?
   guard AXObserverCreate(pid, axCallback, &o) == .success, let o else { return }
   let el = AXUIElementCreateApplication(pid)
-  for n in appNotes { AXObserverAddNotification(o, el, n as CFString, nil) }
+  // An app that is still launching answers cannotComplete; retry rather than keep an observer that never fires.
+  guard appNotes.allSatisfy({ AXObserverAddNotification(o, el, $0 as CFString, nil) == .success }) else {
+    if !a.isTerminated { DispatchQueue.main.asyncAfter(deadline: .now() + 0.5) { observe(a) } }
+    return
+  }
   CFRunLoopAddSource(CFRunLoopGetMain(), AXObserverGetRunLoopSource(o), .commonModes)
   observers[pid] = o
 }
PATCH

mkdir -p "$install_prefix/bin"
/usr/bin/make -C "$source_directory" install "PREFIX=$install_prefix"
