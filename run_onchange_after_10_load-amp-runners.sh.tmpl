#!/usr/bin/env bash

# chezmoi:template:left-delimiter="# {{" right-delimiter="}}"
# LaunchAgent hash: # {{ include "Library/LaunchAgents/com.tifan.amp-runners.plist.tmpl" | sha256sum }}
# Amp task hash: # {{ include "dot_config/mise/tasks/agents/start/executable_amp" | sha256sum }}
# Shared task helper hash: # {{ include "dot_config/mise/tasks/agents/lib.sh" | sha256sum }}

set -Eeuo pipefail

uid="$(/usr/bin/id -u)"
readonly domain="gui/$uid"
readonly service="$domain/com.tifan.amp-runners"
readonly plist="$HOME/Library/LaunchAgents/com.tifan.amp-runners.plist"

mkdir -p "$HOME/Library/Logs"
if /bin/launchctl print "$service" >/dev/null 2>&1; then
	/bin/launchctl bootout "$service"
	for _ in {1..50}; do
		if ! /bin/launchctl print "$service" >/dev/null 2>&1; then
			break
		fi
		sleep 0.1
	done
fi

if /bin/launchctl print "$service" >/dev/null 2>&1; then
	printf 'LaunchAgent did not unload: %s\n' "$service" >&2
	exit 1
fi

/bin/launchctl bootstrap "$domain" "$plist"
