#!/usr/bin/env bash
set -Eeuo pipefail

readonly SOURCE_APP="${HELIUM_APP_PATH:-/Applications/Helium.app}"
readonly APPS_DIR="$HOME/Applications"
readonly DATA_DIR="$HOME/Library/Application Support"

fail() {
	printf '%s\n' "$1" >&2
	exit 1
}

usage() {
	cat <<'USAGE'
Usage: setup-helium <agents|work|extra>

Create an isolated Helium app instance.
USAGE
}

set_plist_value() {
	local plist="$1"
	local key="$2"
	local value="$3"

	if /usr/libexec/PlistBuddy -c "Set :$key $value" "$plist" >/dev/null 2>&1; then
		return
	fi

	/usr/libexec/PlistBuddy -c "Add :$key string $value" "$plist"
}

plist_value() {
	local plist="$1"
	local key="$2"

	/usr/libexec/PlistBuddy -c "Print :$key" "$plist" 2>/dev/null
}

instance_is_current() {
	local app_path="$1"
	local app_name="$2"
	local bundle_id="$3"
	local user_data_dir="$4"
	local cdp_port="${5:-}"
	local source_plist="$SOURCE_APP/Contents/Info.plist"
	local target_plist="$app_path/Contents/Info.plist"
	local source_version
	local target_version
	local source_short_version
	local target_short_version
	local bundle_executable
	local executable

	[[ -d "$app_path" && -f "$source_plist" && -f "$target_plist" ]] || return 1

	source_version="$(plist_value "$source_plist" CFBundleVersion)" || return 1
	target_version="$(plist_value "$target_plist" CFBundleVersion)" || return 1
	[[ -n "$source_version" && "$source_version" == "$target_version" ]] || return 1

	source_short_version="$(plist_value "$source_plist" CFBundleShortVersionString)" || return 1
	target_short_version="$(plist_value "$target_plist" CFBundleShortVersionString)" || return 1
	[[ -n "$source_short_version" && "$source_short_version" == "$target_short_version" ]] || return 1

	[[ "$(plist_value "$target_plist" CFBundleIdentifier)" == "$bundle_id" ]] || return 1
	[[ "$(plist_value "$target_plist" CFBundleName)" == "$app_name" ]] || return 1
	[[ "$(plist_value "$target_plist" CFBundleDisplayName)" == "$app_name" ]] || return 1

	bundle_executable="$(plist_value "$target_plist" CFBundleExecutable)" || return 1
	executable="$app_path/Contents/MacOS/$bundle_executable"
	[[ -x "$executable" && -x "$executable.bin" ]] || return 1
	grep -Fq -- "$bundle_executable.bin" "$executable" || return 1
	grep -Fq -- '--user-data-dir=' "$executable" || return 1
	grep -Fq -- '--no-first-run' "$executable" || return 1
	grep -Fq -- "$user_data_dir" "$executable" || return 1

	if [[ -n "$cdp_port" ]]; then
		grep -Fq -- '--remote-debugging-address=127.0.0.1' "$executable" || return 1
		grep -Fq -- '--remote-debugging-port=' "$executable" || return 1
	fi
}

assert_not_running() {
	local app_path="$1"

	if pgrep -f -- "$app_path/Contents/MacOS/" >/dev/null; then
		fail "Quit Helium before recreating: $app_path"
	fi
}

create_instance() {
	local app_path="$1"
	local app_name="$2"
	local bundle_id="$3"
	local user_data_dir="$4"
	local cdp_port="${5:-}"
	local plist
	local bundle_executable
	local executable_dir
	local original_executable
	local wrapped_executable

	[[ "$app_path" != "$SOURCE_APP" ]] || fail "Refusing to overwrite the source app"

	if instance_is_current "$app_path" "$app_name" "$bundle_id" "$user_data_dir" "$cdp_port"; then
		printf 'Already current %s\n' "$app_path"
		return
	fi

	assert_not_running "$app_path"

	mkdir -p "$(dirname "$app_path")"
	rm -rf "$app_path"
	cp -R "$SOURCE_APP" "$app_path"

	plist="$app_path/Contents/Info.plist"
	set_plist_value "$plist" CFBundleIdentifier "$bundle_id"
	set_plist_value "$plist" CFBundleName "$app_name"
	set_plist_value "$plist" CFBundleDisplayName "$app_name"
	/usr/libexec/PlistBuddy -c 'Delete :CFBundleURLTypes' "$plist" >/dev/null 2>&1 || true

	bundle_executable="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleExecutable' "$plist")"
	executable_dir="$app_path/Contents/MacOS"
	original_executable="$executable_dir/$bundle_executable"
	wrapped_executable="$executable_dir/$bundle_executable.bin"

	mv "$original_executable" "$wrapped_executable"
	if [[ -n "$cdp_port" ]]; then
		cat >"$original_executable" <<LAUNCHER
#!/usr/bin/env bash
set -Eeuo pipefail

readonly HELIUM_USER_DATA_DIR="\${HELIUM_AGENTS_USER_DATA_DIR:-$user_data_dir}"
readonly AGENT_BROWSER_PORT="\${AGENT_BROWSER_PORT:-$cdp_port}"

mkdir -p "\$HELIUM_USER_DATA_DIR"
exec "\$(dirname "\$0")/$bundle_executable.bin" \\
  --remote-debugging-address=127.0.0.1 \\
  --remote-debugging-port="\$AGENT_BROWSER_PORT" \\
  --user-data-dir="\$HELIUM_USER_DATA_DIR" \\
  --no-first-run \\
  "\$@"
LAUNCHER
	else
		cat >"$original_executable" <<LAUNCHER
#!/usr/bin/env bash
set -Eeuo pipefail

readonly HELIUM_USER_DATA_DIR="\${HELIUM_USER_DATA_DIR:-$user_data_dir}"

mkdir -p "\$HELIUM_USER_DATA_DIR"
exec "\$(dirname "\$0")/$bundle_executable.bin" \\
  --user-data-dir="\$HELIUM_USER_DATA_DIR" \\
  --no-first-run \\
  "\$@"
LAUNCHER
	fi
	chmod +x "$original_executable"

	codesign --force --deep --sign - "$app_path" >/dev/null
	printf 'Created %s\n' "$app_path"
}

main() {
	local instance="${1:-}"
	local app_path
	local app_name
	local bundle_id
	local user_data_dir
	local cdp_port=""

	[[ -d "$SOURCE_APP" ]] || fail "Helium app not found: $SOURCE_APP"

	case "$instance" in
	agents)
		app_path="${HELIUM_AGENTS_APP_PATH:-$APPS_DIR/Helium for Agents.app}"
		app_name="Helium for Agents"
		bundle_id="net.imput.helium.foragents"
		user_data_dir="${HELIUM_AGENTS_USER_DATA_DIR:-$DATA_DIR/net.imput.helium.foragents}"
		cdp_port="9222"
		;;
	work)
		app_path="${HELIUM_WORK_APP_PATH:-$APPS_DIR/Helium Work.app}"
		app_name="Helium Work"
		bundle_id="net.imput.helium.work"
		user_data_dir="${HELIUM_WORK_USER_DATA_DIR:-$DATA_DIR/net.imput.helium.work}"
		;;
	extra)
		app_path="${HELIUM_EXTRA_APP_PATH:-$APPS_DIR/Helium Extra.app}"
		app_name="Helium Extra"
		bundle_id="net.imput.helium.extra"
		user_data_dir="${HELIUM_EXTRA_USER_DATA_DIR:-$DATA_DIR/net.imput.helium.extra}"
		;;
	-h | --help | help)
		usage
		return
		;;
	*)
		usage >&2
		return 2
		;;
	esac

	create_instance "$app_path" "$app_name" "$bundle_id" "$user_data_dir" "$cdp_port"

	if [[ "$instance" == agents ]]; then
		local old_app="$APPS_DIR/Helium Debug.app"
		if [[ -e "$old_app" ]]; then
			assert_not_running "$old_app"
			rm -rf "$old_app"
			printf 'Removed %s\n' "$old_app"
		fi
	fi
}

main "$@"
