#!/usr/bin/env bash
set -Eeuo pipefail

amp_session=box-amp
agents=(amp chezmoi aquasense-app aquasense-service backoffice-windmill core-service gcp-terraform kamal-deploy)
chezmoi_dir="$HOME/.local/share/chezmoi"
discover_dir="$HOME/projects/personal"
projects_dir="$HOME/projects/work"

usage() {
	printf 'Usage: %s {start|stop} <agent> | %s status\n' "${0##*/}" "${0##*/}" >&2
	printf 'Agents: %s\n' "${agents[*]}" >&2
	exit 2
}

require_command() {
	if ! command -v "$1" >/dev/null 2>&1; then
		printf 'Missing required command: %s\n' "$1" >&2
		exit 1
	fi
}

require_directory() {
	if [[ ! -d $1 ]]; then
		printf 'Missing directory: %s\n' "$1" >&2
		exit 1
	fi
}

start_session() {
	local session=$1
	local cwd=$2
	local shell_command=$3

	if tmux has-session -t "$session" 2>/dev/null; then
		printf '%s is already running (attach with: tmux attach -t %s)\n' "$session" "$session"
		return
	fi

	tmux new-session -d -s "$session" -c "$cwd" "$shell_command"
	printf 'Started %s (attach with: tmux attach -t %s)\n' "$session" "$session"
}

start_claude_session() {
	local session=$1
	local cwd=$2
	local spawn_mode=$3

	start_session "$session" "$cwd" \
		"exec claude remote-control --permission-mode=bypassPermissions --spawn=$spawn_mode --capacity=10 --no-chrome"
}

stop_session() {
	local session=$1

	if tmux has-session -t "$session" 2>/dev/null; then
		tmux kill-session -t "$session"
		printf 'Stopped %s\n' "$session"
	else
		printf '%s is not running\n' "$session"
	fi
}

status_session() {
	local agent=$1
	local session=$2
	local pane_status
	local status

	if ! tmux has-session -t "$session" 2>/dev/null; then
		status='not running'
	else
		pane_status=$(tmux display-message -p -t "$session" '#{pane_dead}:#{pane_current_command}')
		case $pane_status in
		0:*)
			status="running (${pane_status#*:})"
			;;
		1:*)
			status='process exited (tmux session remains)'
			;;
		*)
			status='unknown'
			;;
		esac
	fi

	printf '%-22s %-40s %s\n' "$agent" "$session" "$status"
	[[ $status != unknown ]]
}

status_all() {
	local agent
	local session
	local failed=0

	printf '%-22s %-40s %s\n' 'AGENT' 'TMUX SESSION' 'STATUS'
	for agent in "${agents[@]}"; do
		if [[ $agent == amp ]]; then
			session=$amp_session
		else
			session="box-claude-$agent"
		fi
		if ! status_session "$agent" "$session"; then
			failed=1
		fi
	done
	return "$failed"
}

[[ $# -ge 1 ]] || usage
operation=$1

if [[ $operation == status ]]; then
	[[ $# -eq 1 ]] || usage
	require_command tmux
	status_all || exit $?
	exit 0
fi

[[ $# -eq 2 && ($operation == start || $operation == stop) ]] || usage
agent=$2

case $agent in
amp)
	session=$amp_session
	cwd=$chezmoi_dir
	;;
chezmoi)
	session=box-claude-chezmoi
	cwd=$chezmoi_dir
	spawn_mode=same-dir
	;;
aquasense-app)
	session=box-claude-aquasense-app
	cwd=$projects_dir/aquasense-app
	spawn_mode=same-dir
	;;
aquasense-service)
	session=box-claude-aquasense-service
	cwd=$projects_dir/aquasense-service
	spawn_mode=same-dir
	;;
backoffice-windmill)
	session=box-claude-backoffice-windmill
	cwd=$projects_dir/backoffice-windmill
	spawn_mode=same-dir
	;;
core-service)
	session=box-claude-core-service
	cwd=$projects_dir/core-service
	spawn_mode=same-dir
	;;
gcp-terraform)
	session=box-claude-gcp-terraform
	cwd=$projects_dir/gcp-terraform
	spawn_mode=same-dir
	;;
kamal-deploy)
	session=box-claude-kamal-deploy
	cwd=$projects_dir/kamal-deploy
	spawn_mode=same-dir
	;;
*)
	usage
	;;
esac

require_command tmux

case $operation in
start)
	require_directory "$cwd"
	if [[ $agent == amp ]]; then
		require_command amp
		require_directory "$discover_dir"
		start_session "$session" "$cwd" \
			"exec amp --no-tui --runner-id=box --no-serve-cwd --discover-dirs=\"\$HOME/projects/personal\" --dir=\"\$HOME/.local/share/chezmoi\""
	else
		require_command claude
		# Keep Claude sessions inside tmux so Herdr sees tmux instead of Claude.
		start_claude_session "$session" "$cwd" "$spawn_mode"
	fi
	;;
stop)
	stop_session "$session"
	;;
*)
	usage
	;;
esac
