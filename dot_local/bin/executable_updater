#!/usr/bin/env bash
set -uo pipefail

available() { command -v "$1" >/dev/null 2>&1; }

step() {
	local label=$1
	shift

	printf '\n==> %s\n' "$label"
	if ! "$@"; then
		printf 'Skipping failed step: %s\n' "$label" >&2
		failed=1
	fi
}

failed=0

case ${1:-help} in
start)
	available brew && step 'Homebrew packages' env HOMEBREW_NO_ASK=1 brew upgrade

	if available mise; then
		ruby_before=$(mise where ruby 2>/dev/null || true)
		step 'mise tools' mise upgrade --yes
		ruby_after=$(mise where ruby 2>/dev/null || true)

		if [[ -n $ruby_before && -n $ruby_after && $ruby_before != "$ruby_after" ]] && mise list | grep -q '^[[:space:]]*gem:'; then
			step 'Reinstall gem tools after Ruby changed' mise install -f 'gem:*'
		fi
	fi

	available uv && step 'uv tools' uv tool upgrade --all
	available gh && step 'GitHub extensions' gh extension upgrade --all

	if available ya; then
		step 'Yazi packages' ya pkg upgrade
		available chezmoi && step 'Sync Yazi package.toml' chezmoi add "$HOME/.config/yazi/package.toml"
	fi

	available bun && step 'Bun global packages' bun update --global --latest
	available bunx && step 'Agent skills' bunx skills update -g
	available pi && step 'Pi and installed packages' pi update --all
	available nvim && step 'Neovim packages' nvim --headless -c 'lua vim.pack.update(nil, { force = true })' -c 'qa!'

	if [[ $(uname -s) == Darwin ]] && available setup-helium; then
		for instance in agents work extra; do
			step "Helium ($instance)" setup-helium "$instance"
		done
	fi

	exit "$failed"
	;;
clean)
	if available mise; then
		step 'mise unused versions' mise prune -y
		step 'mise cache' mise cache clear -y
	fi

	available pnpm && step 'pnpm store' pnpm store prune

	if available brew; then
		step 'Homebrew cleanup' brew cleanup --prune-prefix
		step 'Homebrew old versions' brew cleanup --prune=all
		step 'Homebrew unused dependencies' brew autoremove
	fi

	available npm && step 'npm cache' npm cache clean --force
	available uv && step 'uv cache' uv cache clean

	if available go; then
		step 'Go build cache' go clean -cache
		step 'Go module cache' go clean -modcache
	fi

	if [[ $(hostname -s) != box ]] && available docker && docker info >/dev/null 2>&1; then
		# Volumes may contain databases; prune them explicitly when needed.
		step 'Docker stopped containers' docker container prune -f
		step 'Docker unused networks' docker network prune -f
		step 'Docker unused images' docker image prune -a -f
		step 'Docker build cache' docker builder prune -f
	fi

	if [[ $(uname -s) == Linux ]]; then
		[[ ! -d $HOME/.local/share/Trash ]] || step 'Linux Trash' sudo -n find "$HOME/.local/share/Trash" -mindepth 2 -delete
		available journalctl && step 'User journal' journalctl --user --vacuum-size=200M
	fi

	available mo && step 'Mole cleanup' mo clean

	exit "$failed"
	;;
help | --help | -h) printf '%s\n' 'updater start  # Upgrade installed tools' 'updater clean  # Remove caches and unused resources (optional)' ;;
*)
	printf 'Unknown updater command: %s\n' "$1" >&2
	exit 2
	;;
esac
