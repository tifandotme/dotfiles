#!/usr/bin/env bash
# shellcheck disable=SC2016
set -Eeuo pipefail

API_URL="https://api.linear.app/graphql"
UNREAD_QUERY='query { notificationsUnreadCount }'
NOTIFICATIONS_QUERY='query($after:String,$first:Int!){inboxNotifications(first:$first,after:$after,unreadOnly:true){nodes{id createdAt type title subtitle url inboxUrl}pageInfo{hasNextPage endCursor}}}'
CURL_BIN="${LINEAR_CURL_BIN:-$(command -v curl 2>/dev/null || true)}"
JQ_BIN="${LINEAR_JQ_BIN:-$(command -v jq 2>/dev/null || true)}"

usage() {
	cat <<'EOF'
Usage:
  linear unread [--account personal|work|all] [--json]
  linear notifications [--account personal|work|all] [--limit N] [--json]

The default account is all. Personal uses LINEAR_PERSONAL_API_KEY and Work uses
LINEAR_WORK_API_KEY from ~/.secrets.
EOF
}

load_secrets() {
	if [[ -r "$HOME/.secrets" ]]; then
		set +u
		# shellcheck disable=SC1091
		source "$HOME/.secrets"
		set -u
	fi
}

api_key_for() {
	case "$1" in
	personal) printf '%s' "${LINEAR_PERSONAL_API_KEY:-}" ;;
	work) printf '%s' "${LINEAR_WORK_API_KEY:-}" ;;
	*) return 2 ;;
	esac
}

api_request() {
	local api_key="$1"
	local query="$2"
	local variables="$3"
	local payload

	payload="$("$JQ_BIN" -cn --arg query "$query" --argjson variables "$variables" '{query:$query,variables:$variables}')"
	printf 'header = "Authorization: %s"\n' "$api_key" | "$CURL_BIN" \
		--config - \
		--connect-timeout 2 \
		--max-time 5 \
		--silent \
		--fail \
		-H 'Content-Type: application/json' \
		--data "$payload" \
		"$API_URL"
}

account_count() {
	local account="$1"
	local api_key response count status=ok
	api_key="$(api_key_for "$account")"
	if [[ -z "$api_key" ]]; then
		status=missing
	elif ! response="$(api_request "$api_key" "$UNREAD_QUERY" '{}')"; then
		status=error
	elif ! count="$("$JQ_BIN" -er 'select((.errors // []) | length == 0) | .data.notificationsUnreadCount | select(type == "number")' <<<"$response")"; then
		status=error
	fi
	if [[ "$status" == ok ]]; then
		printf '{"status":"ok","count":%s}' "$count"
	else
		printf '{"status":"%s","count":null}' "$status"
	fi
}

account_notifications() {
	local account="$1"
	local limit="$2"
	local api_key after='' remaining="$limit" first response page page_count has_next variables status=ok
	local notifications='[]'
	api_key="$(api_key_for "$account")"
	if [[ -z "$api_key" ]]; then
		printf '{"status":"missing","notifications":[]}'
		return 0
	fi

	while ((remaining > 0)); do
		first="$remaining"
		if ((first > 50)); then first=50; fi
		variables="$("$JQ_BIN" -cn --arg after "$after" --argjson first "$first" \
			'{after:if $after == "" then null else $after end,first:$first}')"
		if ! response="$(api_request "$api_key" "$NOTIFICATIONS_QUERY" "$variables")"; then
			status=error
			break
		fi
		if ! "$JQ_BIN" -e '(.errors // [] | length == 0) and (.data.inboxNotifications.nodes | type == "array")' >/dev/null 2>&1 <<<"$response"; then
			status=error
			break
		fi

		page="$("$JQ_BIN" -c '.data.inboxNotifications.nodes | map({id,createdAt,type,title,subtitle,url,inboxUrl})' <<<"$response")"
		notifications="$("$JQ_BIN" -cn --argjson existing "$notifications" --argjson page "$page" '$existing + $page')"
		page_count="$("$JQ_BIN" -r 'length' <<<"$page")"
		if ((page_count == 0)); then break; fi
		remaining=$((remaining - page_count))
		has_next="$("$JQ_BIN" -r '.data.inboxNotifications.pageInfo.hasNextPage' <<<"$response")"
		[[ "$has_next" == true && "$remaining" -gt 0 ]] || break
		after="$("$JQ_BIN" -r '.data.inboxNotifications.pageInfo.endCursor // empty' <<<"$response")"
		[[ -n "$after" ]] || {
			status=error
			break
		}
	done

	"$JQ_BIN" -cn --arg status "$status" --argjson notifications "$notifications" \
		'{status:$status,notifications:$notifications}'
}

main() {
	local command_name="${1:-}"
	local account=all format=text limit=20 limit_set=false
	local personal work result status
	shift || true

	if [[ "$command_name" == -h || "$command_name" == --help || -z "$command_name" ]]; then
		usage
		return 0
	fi
	if [[ "$command_name" != unread && "$command_name" != notifications ]]; then
		usage >&2
		return 2
	fi
	while (($#)); do
		case "$1" in
		--account)
			(($# >= 2)) || {
				usage >&2
				return 2
			}
			account="$2"
			shift 2
			;;
		--json)
			format=json
			shift
			;;
		--limit)
			(($# >= 2)) && [[ "$2" =~ ^[1-9][0-9]*$ ]] || {
				usage >&2
				return 2
			}
			limit=$((10#$2))
			limit_set=true
			shift 2
			;;
		*)
			printf 'Unknown option: %s\n' "$1" >&2
			usage >&2
			return 2
			;;
		esac
	done
	case "$account" in
	personal | work | all) ;;
	*)
		printf 'Unknown account: %s\n' "$account" >&2
		return 2
		;;
	esac
	if [[ "$command_name" == unread && "$limit_set" == true ]]; then
		printf '%s\n' '--limit is only valid for notifications' >&2
		return 2
	fi
	[[ -n "$CURL_BIN" && -x "$CURL_BIN" ]] || {
		printf 'curl was not found\n' >&2
		return 1
	}
	[[ -n "$JQ_BIN" && -x "$JQ_BIN" ]] || {
		printf 'jq was not found\n' >&2
		return 1
	}
	load_secrets

	if [[ "$command_name" == unread ]]; then
		if [[ "$account" != all ]]; then
			result="$(account_count "$account")"
			status="$("$JQ_BIN" -r '.status' <<<"$result")"
			if [[ "$format" == json ]]; then
				printf '%s\n' "$result"
				return 0
			fi
			[[ "$status" == ok ]] || {
				printf 'linear: %s account is %s\n' "$account" "$status" >&2
				return 1
			}
			printf '%s unread: %s\n' "$account" "$("$JQ_BIN" -r '.count' <<<"$result")"
			return 0
		fi

		personal="$(account_count personal)"
		work="$(account_count work)"
		result="$("$JQ_BIN" -cn --argjson personal "$personal" --argjson work "$work" '
      {
        personal:$personal,
        work:$work,
        total:(($personal.count // 0) + ($work.count // 0)),
        complete:($personal.status == "ok" and $work.status == "ok")
      }
    ')"
		if [[ "$format" == json ]]; then
			printf '%s\n' "$result"
		else
			for account in personal work; do
				status="$("$JQ_BIN" -r --arg account "$account" '.[$account].status' <<<"$result")"
				printf '%s unread: ' "$account"
				if [[ "$status" == ok ]]; then
					"$JQ_BIN" -r --arg account "$account" '.[$account].count' <<<"$result"
				else
					printf '%s\n' "$status"
				fi
			done
			printf 'Known total: %s\n' "$("$JQ_BIN" -r '.total' <<<"$result")"
		fi
		return 0
	fi

	if [[ "$account" == all ]]; then
		personal="$(account_notifications personal "$limit")"
		work="$(account_notifications work "$limit")"
		result="$("$JQ_BIN" -cn --argjson personal "$personal" --argjson work "$work" \
			'{personal:$personal,work:$work}')"
	else
		result="$(account_notifications "$account" "$limit")"
		result="$("$JQ_BIN" -cn --arg account "$account" --argjson result "$result" '{($account):$result}')"
	fi
	if [[ "$format" == json ]]; then
		printf '%s\n' "$result"
		return 0
	fi
	for profile in personal work; do
		[[ "$account" == all || "$account" == "$profile" ]] || continue
		personal="$("$JQ_BIN" -c --arg profile "$profile" '.[$profile] // empty' <<<"$result")"
		[[ -n "$personal" ]] || continue
		status="$("$JQ_BIN" -r '.status' <<<"$personal")"
		if [[ "$status" != ok ]]; then
			printf '%s notifications: %s\n' "$profile" "$status"
			continue
		fi
		printf '%s unread notifications:\n' "$profile"
		"$JQ_BIN" -r '.notifications[] | "  \(.title)\n  \(.inboxUrl // .url)"' <<<"$personal"
	done
}

main "$@"
