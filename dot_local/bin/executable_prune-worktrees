#!/usr/bin/env bun
import { existsSync } from "node:fs";
import { dirname, join } from "node:path";

const directory = dirname(import.meta.path);
const installed = join(directory, "open-project");
const entry = existsSync(installed) ? installed : join(directory, "executable_open-project");
const child = Bun.spawn([process.execPath, entry, "_prune", ...process.argv.slice(2)], {
  stdin: "inherit",
  stdout: "inherit",
  stderr: "inherit",
});
process.exitCode = await child.exited;
