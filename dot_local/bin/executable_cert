#!/usr/bin/env bash
set -Eeuo pipefail

action=${1:-help}
target=${2:-}

if [[ $action == decode ]]; then
	exec openssl x509 -in "${target:?Missing certificate file}" -text -noout
fi

case $action in
dates | check | issuer | finger)
	[[ -n $target ]] || {
		printf '%s\n' 'Missing domain' >&2
		exit 2
	}
	;;
*)
	printf '%s\n' 'cert dates|check|issuer|finger DOMAIN' 'cert decode FILE'
	exit 0
	;;
esac

certificate=$(openssl s_client -servername "$target" -connect "$target:443" </dev/null 2>/dev/null)

case $action in
dates) printf '%s\n' "$certificate" | openssl x509 -noout -dates ;;
issuer) printf '%s\n' "$certificate" | openssl x509 -noout -issuer ;;
finger)
	printf '%s\n' "$certificate" | openssl x509 -noout -fingerprint -sha256
	printf '%s\n' "$certificate" | openssl x509 -noout -fingerprint -sha1
	;;
check)
	expiry=$(printf '%s\n' "$certificate" | openssl x509 -noout -enddate)
	expiry=${expiry#*=}

	if [[ $(uname -s) == Darwin ]]; then
		epoch=$(LC_ALL=C date -j -u -f '%b %e %T %Y %Z' "$expiry" +%s)
	else
		epoch=$(LC_ALL=C date -u -d "$expiry" +%s)
	fi

	remaining=$((epoch - $(date +%s)))
	expired=false

	if ((remaining < 0)); then
		expired=true
		days=$(((remaining - 43200) / 86400))
	else
		days=$(((remaining + 43200) / 86400))
	fi

	jq -n --arg domain "$target" --arg expiry "$expiry" --argjson expired "$expired" --argjson days "$days" '{domain:$domain, expired:$expired, expiry_date:$expiry, days_left:$days}'
	;;
esac
