<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.tifan.bird-refresh</string>
    <key>ProgramArguments</key>
    <array>
      <string>/opt/homebrew/bin/mise</string>
      <string>run</string>
      <string>--quiet</string>
      <string>--raw</string>
      <string>bird:refresh</string>
      <string>--no-box</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>{{ .chezmoi.homeDir }}/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/Library/Logs/com.tifan.bird-refresh.out.log</string>
    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/Library/Logs/com.tifan.bird-refresh.err.log</string>
  </dict>
</plist>
