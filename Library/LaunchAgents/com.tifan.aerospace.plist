<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>Label</key>
		<string>com.tifan.aerospace</string>
		<key>ProgramArguments</key>
		<array>
			<string>/bin/sh</string>
			<string>-c</string>
			<string>/bin/sleep 15
				exec /usr/bin/open -a /Applications/AeroSpace.app</string>
		</array>
		<key>RunAtLoad</key>
		<true/>
	</dict>
</plist>
