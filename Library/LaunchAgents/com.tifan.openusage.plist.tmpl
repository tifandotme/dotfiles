<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.tifan.openusage</string>
    <key>ProgramArguments</key>
    <array>
      <string>/bin/sh</string>
      <string>-c</string>
      <string>sleep 60
exec /Applications/OpenUsage.app/Contents/MacOS/OpenUsage</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
      <key>PI_CODING_AGENT_DIR</key>
      <string>{{ .chezmoi.homeDir }}/.config/pi</string>
      <key>CLAUDE_CONFIG_DIR</key>
      <string>{{ .chezmoi.homeDir }}/.config/claude</string>
      <key>CODEX_HOME</key>
      <string>{{ .chezmoi.homeDir }}/.config/codex</string>
      <key>CODEX_SQLITE_HOME</key>
      <string>{{ .chezmoi.homeDir }}/.local/state/codex</string>
      <key>PI_AGENT_DIR</key>
      <string>{{ .chezmoi.homeDir }}/.config/pi/sessions</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
  </dict>
</plist>
