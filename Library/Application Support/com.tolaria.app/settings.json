{
  "auto_pull_interval_minutes": 0,
  "git_enabled": false,
  "autogit_enabled": false,
  "autogit_idle_threshold_seconds": 90,
  "autogit_inactive_threshold_seconds": 30,
  "auto_advance_inbox_after_organize": false,
  "telemetry_consent": false,
  "crash_reporting_enabled": false,
  "analytics_enabled": false,
  "anonymous_id": null,
  "release_channel": null,
  "theme_mode": "system",
  "ui_language": null,
  "date_display_format": "european",
  "note_width_mode": "normal",
  "sidebar_type_pluralization_enabled": true,
  "initial_h1_auto_rename_enabled": true,
  "ai_features_enabled": true,
  "default_ai_agent": "pi",
  "default_ai_target": "agent:pi",
  "ai_model_providers": null,
  "ai_workspace_conversations": null,
  "hide_gitignored_files": true,
  "all_notes_show_pdfs": false,
  "all_notes_show_images": false,
  "all_notes_show_unsupported": false,
  "multi_workspace_enabled": false
}