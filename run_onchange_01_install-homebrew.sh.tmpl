#!/usr/bin/env bash

# chezmoi:template:left-delimiter="# {{" right-delimiter=}}
# Brewfile hash: # {{ include "dot_Brewfile.tmpl" | sha256sum }}

if command -v brew &>/dev/null; then
	# Homebrew creates its trust directory if absent and rejects it if group-writable.
	if [[ -d "$HOME/.config/homebrew" ]]; then
		chmod go-w "$HOME/.config/homebrew" || exit 1
	fi
	# Rendered Brewfile (hostname/OS conditionals); not the raw .tmpl in source.
	brew bundle install --force-cleanup --zap --file="# {{ .chezmoi.destDir }}/.Brewfile"
fi
