brew "vite-plus"       # Unified web development toolchain and vp CLI

# Go
brew "golangci-lint" # Fast linters runner for Go
brew "gopls"         # Language server for Go
brew "templ"         # HTML templating language for Go

# Python
brew "uv" # Fast Python package installer and resolver

# Polyglot runtime manager
brew "mise" # Polyglot runtime manager (asdf rust clone)

