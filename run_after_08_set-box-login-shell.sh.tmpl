#!/usr/bin/env bash

# chezmoi:template:left-delimiter="# {{" right-delimiter="}}"
# {{ if eq .chezmoi.hostname "box" -}}
set -Eeuo pipefail

zsh_path="/home/linuxbrew/.linuxbrew/bin/zsh"
if [[ ! -x "$zsh_path" ]]; then
	printf 'Zsh is not installed at %s; install it with Homebrew, then run chezmoi apply again.\n' "$zsh_path" >&2
	exit 1
fi

user="$(id -un)"
if ! passwd_entry="$(getent passwd "$user")"; then
	printf 'Could not find the login entry for %s.\n' "$user" >&2
	exit 1
fi
current_shell="${passwd_entry##*:}"
if [[ -z "$current_shell" ]]; then
	printf 'Could not find the login shell for %s.\n' "$user" >&2
	exit 1
fi

if ! grep -Fxq "$zsh_path" /etc/shells; then
	if ! printf '%s\n' "$zsh_path" | sudo tee -a /etc/shells >/dev/null; then
		printf 'Could not add %s to /etc/shells.\n' "$zsh_path" >&2
		exit 1
	fi
fi

if [[ "$current_shell" != "$zsh_path" ]]; then
	chsh -s "$zsh_path" "$user"
fi
# {{ end -}}
