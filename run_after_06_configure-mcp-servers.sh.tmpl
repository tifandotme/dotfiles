#!/usr/bin/env bash
# chezmoi:template:left-delimiter="# {{" right-delimiter=}}

set -Eeuo pipefail

warn() {
	printf 'warning: %s\n' "$1" >&2
}

if ! command -v claude >/dev/null 2>&1; then
	exit 0
fi

if ! command -v jq >/dev/null 2>&1; then
	warn 'jq is not installed; skipping MCP server setup'
	exit 0
fi

if [[ -r "$HOME/.secrets" ]]; then
	# shellcheck source=/dev/null
	. "$HOME/.secrets"
fi

# add_mcp NAME JSON: declares a user-scope server. Leaves it alone when every
# key in JSON already matches the stored entry, so unchanged servers keep
# their OAuth state; otherwise replaces it.
add_mcp() {
	local name="$1"
	local json="$2"

	managed+=" $name"
	if jq -e --arg name "$name" --argjson want "$json" \
		'.mcpServers[$name] as $have | $want | to_entries | all(.value == $have[.key])' \
		"$CLAUDE_CONFIG_DIR/.claude.json" >/dev/null 2>&1; then
		return 0
	fi
	claude mcp remove --scope user "$name" >/dev/null 2>&1 || true
	claude mcp add-json --scope user "$name" "$json" || warn "could not add Claude MCP server $name"
}

add_http() {
	add_mcp "$1" "$(jq -n --arg url "$2" '{type: "http", url: $url}')"
}

prune_mcps() {
	local config="$CLAUDE_CONFIG_DIR/.claude.json"
	local names
	local name

	[[ -f "$config" ]] || return 0
	if ! names="$(jq -r '(.mcpServers // {}) | keys[]' "$config")"; then
		warn "cannot read MCP servers from $config; skipping prune"
		return 0
	fi
	while IFS= read -r name; do
		if [[ -z "$name" || " $managed " == *" $name "* ]]; then
			continue
		fi
		claude mcp remove --scope user "$name" ||
			warn "could not remove unmanaged Claude user MCP server $name"
	done <<<"$names"
}

tolaria_node=
tolaria_vault_path=
# {{ if eq .chezmoi.os "darwin" -}}
tolaria_node="$HOME/.local/share/mise/shims/node"
# {{ else if eq .chezmoi.hostname "box" -}}
tolaria_node=node
tolaria_vault_path="$HOME/projects/personal/notes"
# {{ end -}}
tolaria_server="$HOME/.local/share/tolaria-mcp/index.js"

for config_dir in "${XDG_CONFIG_HOME:-$HOME/.config}/claude" "${XDG_CONFIG_HOME:-$HOME/.config}/claude-hadl"; do
	export CLAUDE_CONFIG_DIR="$config_dir"

	managed=

	if fff_bin="$(command -v fff-mcp)"; then
		add_mcp fff "$(jq -n --arg command "$fff_bin" '{type: "stdio", command: $command}')"
	else
		warn 'cannot add Claude MCP server fff; fff-mcp is not installed'
	fi

	if [[ -n "$tolaria_node" ]]; then
		if tolaria_bin="$(command -v "$tolaria_node")"; then
			add_mcp tolaria "$(jq -n --arg command "$tolaria_bin" --arg server "$tolaria_server" \
				--arg vault "$tolaria_vault_path" \
				'{type: "stdio", command: $command, args: [$server],
					env: ({WS_UI_PORT: "9711"} + (if $vault == "" then {} else {VAULT_PATH: $vault} end))}')"
		else
			warn "cannot add Claude MCP server tolaria; $tolaria_node is not installed"
		fi
	fi

	if [[ -n "${PENPOT_MCP_URL:-}" ]]; then
		add_http penpot "$PENPOT_MCP_URL"
	else
		warn 'cannot add Claude MCP server penpot; PENPOT_MCP_URL is unset'
	fi

	prune_mcps
done
